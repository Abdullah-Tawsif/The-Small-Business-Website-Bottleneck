APP_NAME=AgencyForge
ENVIRONMENT=development
# Use a new development file. Migrations to non-/tmp databases require an
# explicit ALLOW_NON_TMP_MIGRATIONS=1 in the migration command environment.
DATABASE_URL=sqlite:///./agencyforge-dev.sqlite
# Generate a unique secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace_with_at_least_32_random_bytes
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Optional in development; required when ENVIRONMENT=production.
# RATE_LIMIT_REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=12
PUBLIC_WRITE_RATE_LIMIT_REQUESTS=12
AI_RATE_LIMIT_REQUESTS=6
API_RATE_LIMIT_REQUESTS=120
ADMIN_RATE_LIMIT_REQUESTS=90
READINESS_RATE_LIMIT_REQUESTS=10
# Comma-separated actual ingress CIDRs only; forwarded headers are ignored by default.
TRUSTED_PROXY_CIDRS=
AI_ACCOUNT_DAILY_LIMIT=60
AI_SESSION_DAILY_LIMIT=20
AI_GLOBAL_DAILY_LIMIT=1000
AI_BUDGET_NAMESPACE=agencyforge
MAX_REQUEST_BODY_BYTES=1000000
